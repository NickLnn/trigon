# Copy to .env next to docker-compose.yml on the NAS (never commit the real one).

# Which images to run: latest = stable (main branch), dev = newest work (dev branch)
TRIGON_TAG=latest

# Public address people open (change to https://… once Cloudflare is in front)
APP_URL=http://192.168.31.173:8797
WEB_PORT=8797
COLLAB_PORT=4001
POSTGRES_PORT=15432

POSTGRES_USER=trigon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trigon

# 32+ random characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false

# Everything below can also be managed in Trigon → Settings (UI values win once saved)
ALLOW_LOCAL_SIGNUP=true
ENTRA_ENABLED=false
LDAP_ENABLED=false
MAX_UPLOAD_MB=50
