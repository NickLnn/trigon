# Copy to .env (repo root). Used by `npm run dev` and by docker compose.

# Image channel for docker compose: latest (main branch, stable) or dev (dev branch)
TRIGON_TAG=latest
# Automatic updates: uncomment to run the "updater" container, which installs new Trigon images
# from GitHub by itself (checks every TRIGON_UPDATE_INTERVAL seconds; databases are never touched).
#COMPOSE_PROFILES=autoupdate
TRIGON_UPDATE_INTERVAL=900

# ─── URLs ─────────────────────────────────────────────────────────────
# Public URL people open in the browser. Must be HTTPS for the PWA install / offline mode
# (browsers only allow service workers on https or localhost) and for Entra sign-in.
APP_URL=http://localhost:3000
API_PORT=4000
# Yjs collaboration WebSocket (Hocuspocus). Internal only: the web container forwards /collab to it.
COLLAB_PORT=4001
WEB_PORT=3000
# Where the Next.js server proxies /api/* (the browser never calls the API directly)
API_INTERNAL_URL=http://localhost:4000
# Browser-visible WebSocket URL. Leave empty to use ws(s)://<current host>/collab (same origin as the app).
NEXT_PUBLIC_COLLAB_URL=

# ─── Database / cache ─────────────────────────────────────────────────
POSTGRES_USER=trigon
# Use a long random password; the API refuses to start in production with "change-me".
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trigon
POSTGRES_PORT=5432
DATABASE_URL=postgres://trigon:change-me@localhost:5432/trigon
REDIS_PORT=6379
# Redis requires this password when set (docker compose passes it to Redis and the API).
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────
# Required, at least 32 random characters — the API refuses to start otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Key for secrets stored in the database (Entra client secret, LDAP/SMTP/SMB passwords). Generate it like
# JWT_ACCESS_SECRET but different. Without it, a key derived from JWT_ACCESS_SECRET is used. Stored secrets
# are re-encrypted automatically on start-up; to rotate, move the old value to SETTINGS_ENCRYPTION_KEY_PREVIOUS.
SETTINGS_ENCRYPTION_KEY=
#SETTINGS_ENCRYPTION_KEY_PREVIOUS=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Cookies are marked Secure automatically on HTTPS requests; true forces it everywhere.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Allow self-registration with email + password (the first user becomes admin)
ALLOW_LOCAL_SIGNUP=true

# ─── Microsoft Entra ID (OIDC sign-in + Graph directory sync) ─────────
# Easiest: leave this section empty and use Settings → Microsoft Entra ID → "Connect to Microsoft".
# Trigon then registers its own app and keeps the sign-in redirect URIs up to date by itself
# (APP_URL plus every HTTPS address an admin opens Trigon at, e.g. a Cloudflare hostname).
# Manual app registration: Web redirect URI = <APP_URL>/api/auth/entra/callback
# API permissions: Microsoft Graph → Application: User.Read.All, Directory.Read.All (admin consent)
#                                     Delegated: openid, profile, email, User.Read
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Override only to pin a single redirect URI (disables the automatic per-address redirects)
ENTRA_REDIRECT_URI=
# Cron for the Graph sync of users, groups and memberships. Empty = manual only (Profile → Directory sync).
ENTRA_SYNC_CRON=0 */6 * * *

# ─── LDAP / Active Directory ──────────────────────────────────────────
LDAP_ENABLED=false
LDAP_URL=ldaps://dc01.example.local:636
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_BIND_DN=CN=svc-trigon,OU=Service Accounts,DC=example,DC=local
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=DC=example,DC=local
# {{username}} is replaced with the (escaped) login name
LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={{username}})(userPrincipalName={{username}})(mail={{username}})))
LDAP_SYNC_USER_FILTER=(&(objectClass=user)(objectCategory=person))
LDAP_GROUP_FILTER=(objectClass=group)
LDAP_SYNC_CRON=30 */6 * * *

# ─── Files ────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
# Keep files in an S3-compatible bucket instead (see docs/s3-storage.md; copy existing files first)
#STORAGE_DRIVER=s3
#S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#S3_REGION=eu-central-1
#S3_BUCKET=trigon-files
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_PREFIX=
#S3_PATH_STYLE=true
MAX_UPLOAD_MB=50
# OCR defaults until an admin saves Settings → Search (languages joined with +; see docs/ocr-languages.md)
#OCR_ENABLED=true
#OCR_LANGUAGES=ell+eng
#OCR_MAX_PAGES=50

# ─── Activity log ─────────────────────────────────────────────────────
# Days of activity history to keep (0 = keep everything).
ACTIVITY_RETENTION_DAYS=365

# ─── Email (can also be set in Settings → Email) ──────────────────────
# EMAIL_PROVIDER=smtp            # none | smtp | microsoft
# EMAIL_FROM=trigon@example.com
# EMAIL_FROM_NAME=Trigon
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls         # starttls | tls | none
# SMTP_USER=
# SMTP_PASSWORD=

# Days deleted pages, folders and files stay in a space's trash before they are removed for good.
TRASH_RETENTION_DAYS=30
